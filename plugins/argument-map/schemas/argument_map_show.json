{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "the argument, attributed, e.g. \"Hume on induction\""
    },
    "conclusion": {
      "type": "string"
    },
    "premises": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "short label shown on the card, e.g. P1"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "objections": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "short label shown on the card, e.g. O1"
          },
          "targets": {
            "type": "string",
            "description": "id of the premise it attacks, or \"conclusion\" for an objection to the inference"
          },
          "by": {
            "type": "string",
            "description": "who raised it"
          },
          "text": {
            "type": "string"
          },
          "replies": {
            "type": "array",
            "maxItems": 4,
            "description": "addressed as <objection id>.<n> in blanks, e.g. O1.1",
            "items": {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "targets",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "blanks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "parts to hide: premise or objection ids, reply ids (O1.1), or \"conclusion\""
    }
  },
  "required": [
    "title",
    "conclusion",
    "premises"
  ],
  "additionalProperties": false
}
